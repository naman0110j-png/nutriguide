# ---------------------------------------------------------------
# Little Joys NutriGuide — environment configuration
# Copy to .env.local. NEVER commit real values.
# Nothing here is prefixed NEXT_PUBLIC_ except the Supabase URL/anon key,
# which are designed to be public. All other values are server-only.
# ---------------------------------------------------------------

# Data backend: "demo" (local JSON store + seeded knowledge base, default)
# or "supabase" (PostgreSQL via Supabase; requires the three values below).
DATA_BACKEND=demo

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only. Used by API routes for knowledge-base reads and admin writes.
SUPABASE_SERVICE_ROLE_KEY=

# Content mode: "demo" shows clearly labelled demo / review-required recipe
# concepts; "production" shows ONLY records with review_status = verified.
CONTENT_MODE=demo

# LLM provider: "none" (deterministic fallback only), "anthropic" or "openai"
# ("openai" works with any OpenAI-compatible chat-completions endpoint).
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=
# Optional: override base URL for OpenAI-compatible providers.
LLM_BASE_URL=
LLM_TIMEOUT_MS=20000

# Admin console. Admin is DISABLED unless both values are set.
ADMIN_PASSWORD=
# Long random string used to sign session cookies (e.g. `openssl rand -hex 32`).
SESSION_SECRET=

# Ingestion (official Little Joys site). Respect robots.txt and rate limits.
INGEST_ENABLED=true
INGEST_USER_AGENT=NutriGuideImporter/0.1 (+contact: replace-with-your-email)
INGEST_MIN_DELAY_MS=2500
INGEST_ALLOWED_HOSTS=ourlittlejoys.com,mosaicwellness.in

# Local demo store location (demo backend only).
DEMO_STORE_PATH=.data/demo-store.json
